# Fill every required value before starting. Compose intentionally rejects these
# blanks so copying this file can never launch with known placeholder credentials.
# Generate four independent high-entropy secrets; never commit real credentials.
SHADOWSHIELD_IMAGE_DIGEST=
SHADOWSHIELD_API_KEY=
SHADOWSHIELD_ADMIN_KEY=
SHADOWSHIELD_POLICY_KEY=
SHADOWSHIELD_POLICY_STATE_KEY=
# Leave empty to disable browser cross-origin access.
SHADOWSHIELD_CORS_ORIGINS=
