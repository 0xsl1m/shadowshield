# Generate independent high-entropy values; never commit real credentials.
SHADOWSHIELD_API_KEY=replace-with-a-random-scan-key
SHADOWSHIELD_ADMIN_KEY=replace-with-a-different-random-administrator-key
SHADOWSHIELD_POLICY_KEY=replace-with-a-different-random-policy-signing-key
# Leave empty to disable browser cross-origin access.
SHADOWSHIELD_CORS_ORIGINS=
